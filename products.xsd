<?xml version="1.0" encoding="UTF-8"?>
<!-- Mike Broman - 9-25-2026 -->

<!-- TigerTech A2 - products schema, using the Venetian Blind design. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:prod="http://tigertech.example/products"
           targetNamespace="http://tigertech.example/products"
           elementFormDefault="qualified">

   <xs:simpleType name="nonEmptyStringType">
      <xs:restriction base="xs:token">
         <xs:minLength value="1"/>
      </xs:restriction>
   </xs:simpleType>

   <xs:simpleType name="skuType">
      <xs:restriction base="xs:string">
         <xs:pattern value="TT-\d{4}"/>
      </xs:restriction>
   </xs:simpleType>

   <xs:simpleType name="moneyType">
      <xs:restriction base="xs:decimal">
         <xs:minInclusive value="0"/>
         <xs:fractionDigits value="2"/>
      </xs:restriction>
   </xs:simpleType>

   <xs:simpleType name="currencyType">
      <xs:restriction base="xs:string">
         <xs:enumeration value="USD"/>
         <xs:enumeration value="EUR"/>
         <xs:enumeration value="GBP"/>
      </xs:restriction>
   </xs:simpleType>

   <xs:simpleType name="tagsType">
      <xs:list itemType="xs:token"/>
   </xs:simpleType>

   <xs:complexType name="priceType">
      <xs:simpleContent>
         <xs:extension base="prod:moneyType">
            <xs:attribute name="currency" type="prod:currencyType"/>
         </xs:extension>
      </xs:simpleContent>
   </xs:complexType>

   <xs:complexType name="catalogType">
      <xs:sequence>
         <xs:element name="product" type="prod:productType"
                     minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
   </xs:complexType>

   <xs:complexType name="productType">
      <xs:sequence>
         <xs:element name="name" type="prod:nonEmptyStringType"/>
         <xs:element name="price" type="prod:priceType"/>
         <xs:element name="stock" type="xs:nonNegativeInteger"/>
         <xs:element name="description" type="prod:nonEmptyStringType"/>
      </xs:sequence>
      <xs:attribute name="sku" type="prod:skuType" use="required"/>
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="tags" type="prod:tagsType" use="optional"/>
   </xs:complexType>

   <xs:element name="catalog" type="prod:catalogType"/>

</xs:schema>
