<!-- TigerTech A2 - master schema. Ties the two vocabularies together. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:cat="http://tigertech.example/categories"
           xmlns:prod="http://tigertech.example/products">

   <xs:import namespace="http://tigertech.example/categories"
              schemaLocation="categories.xsd"/>
   <xs:import namespace="http://tigertech.example/products"
              schemaLocation="products.xsd"/>

   <xs:element name="store">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="header">
               <xs:complexType>
                  <xs:sequence>
                     <xs:element name="title" type="xs:string"/>
                     <xs:element name="notice" type="xs:string"/>
                  </xs:sequence>
               </xs:complexType>
            </xs:element>
            <xs:element ref="cat:categories"/>
            <xs:element ref="prod:catalog"/>
         </xs:sequence>
      </xs:complexType>

      <xs:key name="categoryKey">
         <xs:selector xpath="cat:categories/cat:category"/>
         <xs:field xpath="@catID"/>
      </xs:key>
      <xs:keyref name="productCategoryKeyRef" refer="categoryKey">
         <xs:selector xpath="prod:catalog/prod:product"/>
         <xs:field xpath="@category"/>
      </xs:keyref>
   </xs:element>
</xs:schema>